{
  "name": "telemetry-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TELEMETRY HUB — a telemetry dashboard on Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply telemetry-hub-db --local",
    "db:remote": "wrangler d1 migrations apply telemetry-hub-db --remote",
    "cf:dry": "wrangler deploy --dry-run",
    "config:check": "node scripts/check-config.mjs",
    "import:cwa": "node scripts/import-cwa.mjs",
    "predeploy": "node scripts/check-config.mjs",
    "check": "npm test && npm run config:check",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
