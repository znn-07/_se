{
  "name": "fieldnotebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Field Notes — a paper-warm notebook on Cloudflare Workers and D1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cloudnotes-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudnotes-db --remote",
    "cf:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
